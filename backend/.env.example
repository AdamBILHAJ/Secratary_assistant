# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers -> Python.
# Replace <username>, <password>, and the cluster host. URL-encode special
# characters in the password (e.g. "@" -> "%40").
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=it-department-automation
MONGODB_DB=it_automation

# Fail-fast timeout for Atlas server selection (milliseconds).
MONGODB_TIMEOUT_MS=5000

# --- Google Gemini ---
# Get a key from https://aistudio.google.com/apikey
# Without a key, classroom checks and Word generation use local fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Per-attempt timeout for each Gemini routing call.
GEMINI_TIMEOUT_SECONDS=30
# Ordered fallback models, tried on timeouts, 404, 429 or 5xx responses.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
# Overall wall-clock budget for one routed request.
GEMINI_TOTAL_TIMEOUT_SECONDS=75

# --- Timetable parsing ---
# Relative paths are resolved from the project root/backend/cwd.
# Defaults to Emploi_du_temps_Classes_Sem2.pdf in the project root.
TIMETABLE_PDF_PATH=Emploi_du_temps_Classes_Sem2.pdf
# Set to true to parse + upsert the PDF into MongoDB on every startup.
AUTO_SYNC_SCHEDULES=false

# Optional capacity catalogue, used by the capacity_needed filter.
# Example: {"I6": 30, "I5": 40, "C9": 20, "TI1": 25}
ROOM_CAPACITIES_JSON={}

# --- API ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
